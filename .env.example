# ── Database (SQLite - Windows testing साठी) ──
DATABASE_URL=sqlite:///./license.db

# ── JWT Secret ──
SECRET_KEY=test-secret-key-change-this-in-production-minimum-32-chars

# ── License Encryption ──
LICENSE_ENCRYPTION_KEY=test-encryption-key-for-local-testing-only

# ── Razorpay TEST Keys ──
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
