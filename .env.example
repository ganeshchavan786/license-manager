# ============================================================
# SalaryPay License Server - Environment Configuration
# ============================================================
# हे file copy करा: copy .env.example .env
# नंतर .env मध्ये actual values टाका
# ============================================================

# ── Database ──────────────────────────────────────────────
# Development (SQLite)
DATABASE_URL=sqlite:///./license.db

# Production (PostgreSQL) - uncomment करा
# DATABASE_URL=postgresql://user:password@localhost:5432/salarypay

# ── Security Keys (PRODUCTION मध्ये CHANGE करा!) ──────────
# Minimum 32 characters random string
SECRET_KEY=change-this-to-random-32-char-string-in-production

# License encryption key - NEVER change after deployment!
LICENSE_ENCRYPTION_KEY=change-this-to-random-32-char-string-in-production

# Settings encryption key (SMTP password, Razorpay secret encrypt करण्यासाठी)
ENCRYPTION_KEY=change-this-to-fernet-key-in-production

# Internal API key for cron jobs
INTERNAL_API_KEY=change-this-internal-api-key-in-production

# GitHub Webhook Secret (Auto Deploy साठी)
WEBHOOK_SECRET=change-this-webhook-secret

# ── JWT Configuration ──────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Razorpay Payment Gateway ───────────────────────────────
# Test keys (development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Live keys (production) - Settings page मधून manage करा
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_live_secret_here

# ── CORS Configuration ─────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3441,http://localhost:5173

# Production:
# ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# ── SMTP Email Configuration ───────────────────────────────
# Note: Settings page मधून पण configure करता येते (encrypted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_USE_TLS=True

# Gmail App Password कसे मिळवायचे:
# 1. Google Account → Security → 2-Step Verification enable करा
# 2. Security → App Passwords → Generate
# 3. 16-character password इथे वापरा

# Other SMTP providers:
# Outlook: smtp.office365.com, port 587
# Yahoo: smtp.mail.yahoo.com, port 587
# Custom: your-smtp-server.com, port 587/465

# ── Application URLs ───────────────────────────────────────
APP_NAME=SalaryPay License Server
FRONTEND_URL=http://localhost:3441
SUPPORT_EMAIL=support@yourdomain.com

# Production:
# FRONTEND_URL=https://app.yourdomain.com
# SUPPORT_EMAIL=support@yourdomain.com

# ── Plan Configuration (Defaults) ─────────────────────────
# Note: Settings page मधून dynamic change करता येते
TRIAL_DAYS=7
FREE_OFFLINE_GRACE=15
BASIC_OFFLINE_GRACE=15
PREMIUM_OFFLINE_GRACE=30

# ── Invoice Storage ────────────────────────────────────────
# PDF files इथे save होतात
INVOICE_STORAGE_PATH=invoices

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
# Production: WARNING किंवा ERROR

# ============================================================
# PRODUCTION CHECKLIST:
# ============================================================
# [ ] SECRET_KEY - Random 32+ char string
# [ ] LICENSE_ENCRYPTION_KEY - Random 32+ char string
# [ ] ENCRYPTION_KEY - Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# [ ] RAZORPAY_KEY_ID - Live key (rzp_live_xxx)
# [ ] RAZORPAY_KEY_SECRET - Live secret
# [ ] SMTP credentials - Production email
# [ ] ALLOWED_ORIGINS - Production domains
# [ ] FRONTEND_URL - Production URL
# [ ] DATABASE_URL - PostgreSQL (recommended)
# ============================================================
